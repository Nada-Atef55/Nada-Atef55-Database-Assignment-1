          </mxGeometry>
        </mxCell>
        <mxCell id="ZIqMzufv78w3RDn-adu7-17" parent="ZIqMzufv78w3RDn-adu7-1" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fixedHeader=1;fontStyle=1" value="" vertex="1">
          <mxGeometry height="52" width="756.1500854492188" y="282" as="geometry" />
        </mxCell>
        <mxCell id="ZIqMzufv78w3RDn-adu7-18" parent="ZIqMzufv78w3RDn-adu7-17" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;fontStyle=1" value="&lt;span style=&quot;font-weight: normal;&quot;&gt;&quot;&lt;/span&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;Some rentals come from a reservation&lt;/span&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&quot;&lt;br&gt;&lt;span style=&quot;background-color: rgb(255, 242, 204);&quot;&gt;the relationship between rental and reservation :&amp;nbsp; rental (partial) 1:1 (total) reservation ?&lt;/span&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="52" width="567" as="geometry">
            <mxRectangle height="52" width="567" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ZIqMzufv78w3RDn-adu7-19" parent="ZIqMzufv78w3RDn-adu7-17" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;fontStyle=1" value="&lt;span style=&quot;font-weight: normal;&quot;&gt;7.12&lt;/span&gt;" vertex="1">
          <mxGeometry height="52" width="189" x="567" as="geometry">
            <mxRectangle height="52" width="189" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ZIqMzufv78w3RDn-adu7-20" parent="ZIqMzufv78w3RDn-adu7-1" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fixedHeader=1;fontStyle=1" value="" vertex="1">
          <mxGeometry height="162" width="756.1500854492188" y="334" as="geometry" />
        </mxCell>
        <mxCell id="ZIqMzufv78w3RDn-adu7-21" parent="ZIqMzufv78w3RDn-adu7-20" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;fontStyle=1" value="&lt;div&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&quot;Individual customers drive the car themselves. For corporate rentals, the contract must name which of the&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;company&#39;s authorized drivers is the main driver.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-weight: normal; background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Customers may add additional drivers to a rental for an extra daily fee. The fee may differ from one rental to&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-weight: normal; background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;another.&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight: normal; background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;background-color: rgb(255, 242, 204);&quot;&gt;i had conflict here&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight: 400; background-color: rgb(255, 242, 204);&quot;&gt;i represented it as a M:N relationship between Rental and Authorized Driver, which leads to a new table that connect the rentals of corporate customers with its drivers with fees on extra drivers for the same rental&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight: 400; background-color: rgb(255, 242, 204);&quot;&gt;as individual customer doesn&#39;t have a driver so it won&#39;t take place in this table&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="162" width="567" as="geometry">
            <mxRectangle height="162" width="567" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ZIqMzufv78w3RDn-adu7-22" parent="ZIqMzufv78w3RDn-adu7-20" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;fontStyle=1" value="&lt;span style=&quot;font-weight: normal;&quot;&gt;7.12&lt;/span&gt;" vertex="1">
          <mxGeometry height="162" width="189" x="567" as="geometry">
            <mxRectangle height="162" width="189" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l98-AGDzfHv_nZQfQNVk-1" parent="ZIqMzufv78w3RDn-adu7-1" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fixedHeader=1;fontStyle=1" vertex="1">
          <mxGeometry height="60" width="756.1500854492188" y="496" as="geometry" />
        </mxCell>
        <mxCell id="l98-AGDzfHv_nZQfQNVk-2" parent="l98-AGDzfHv_nZQfQNVk-1" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;fontStyle=1" value="&lt;span style=&quot;font-weight: normal;&quot;&gt;&quot;One rental can only be extended once directly&quot;&lt;/span&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;font-weight: 400; background-color: rgb(255, 242, 204);&quot;&gt;Does this mean the end date of a rental can be updated without new rental once ?&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight: 400; background-color: rgb(255, 242, 204);&quot;&gt;it is beyond DB constraints&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="567" as="geometry">
