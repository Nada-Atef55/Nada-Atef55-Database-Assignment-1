        <mxCell id="ZIqMzufv78w3RDn-adu7-5" parent="ZIqMzufv78w3RDn-adu7-1" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fixedHeader=1;fontStyle=1" value="" vertex="1">
          <mxGeometry height="74" width="756.1500854492188" y="42" as="geometry" />
        </mxCell>
        <mxCell id="ZIqMzufv78w3RDn-adu7-6" parent="ZIqMzufv78w3RDn-adu7-5" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;fontStyle=1" value="&lt;div&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&quot;If someone marks a car as &#39;Under Maintenance&#39; and it&#39;s&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;actually rented out under the table, we need to know who did it and when.&quot;&lt;br&gt;&lt;span style=&quot;background-color: rgb(255, 242, 204);&quot;&gt;Does it mean i need Audit Log table that references to vehicle table to audit all updates on status or it just need the last update ?&amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="74" width="567" as="geometry">
            <mxRectangle height="74" width="567" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ZIqMzufv78w3RDn-adu7-7" parent="ZIqMzufv78w3RDn-adu7-5" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;fontStyle=1" value="&lt;span style=&quot;font-weight: normal;&quot;&gt;7.3&lt;/span&gt;" vertex="1">
          <mxGeometry height="74" width="189" x="567" as="geometry">
            <mxRectangle height="74" width="189" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ZIqMzufv78w3RDn-adu7-8" parent="ZIqMzufv78w3RDn-adu7-1" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fixedHeader=1;fontStyle=1" value="" vertex="1">
          <mxGeometry height="63" width="756.1500854492188" y="116" as="geometry" />
        </mxCell>
        <mxCell id="ZIqMzufv78w3RDn-adu7-9" parent="ZIqMzufv78w3RDn-adu7-8" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;fontStyle=1" value="&lt;span style=&quot;font-weight: normal;&quot;&gt;&quot;If a corporate account is closed, its driver list has no meaning anymore.&quot;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;background-color: rgb(255, 242, 204);&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;Does it mean that when a corporate customer is deleted, i have to delete its drivers (&lt;/span&gt;ON DELETE CASCADE&lt;span style=&quot;font-weight: normal;&quot;&gt;) ?&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="63" width="567" as="geometry">
            <mxRectangle height="63" width="567" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ZIqMzufv78w3RDn-adu7-10" parent="ZIqMzufv78w3RDn-adu7-8" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;fontStyle=1" value="&lt;span style=&quot;font-weight: normal;&quot;&gt;7.7&lt;/span&gt;" vertex="1">
          <mxGeometry height="63" width="189" x="567" as="geometry">
            <mxRectangle height="63" width="189" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ZIqMzufv78w3RDn-adu7-11" parent="ZIqMzufv78w3RDn-adu7-1" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fixedHeader=1;fontStyle=1" value="" vertex="1">
          <mxGeometry height="55" width="756.1500854492188" y="179" as="geometry" />
        </mxCell>
        <mxCell id="ZIqMzufv78w3RDn-adu7-12" parent="ZIqMzufv78w3RDn-adu7-11" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;fontStyle=1" value="&lt;span style=&quot;font-weight: normal;&quot;&gt;&quot;branch manager can then blacklist the customer,&quot;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-weight: 400; background-color: rgb(255, 242, 204);&quot;&gt;Does it mean there is a relationship between manager &amp;amp; blacklist + customer &amp;amp; blacklist ?&lt;/span&gt;&lt;/div&gt;" vertex="1">
